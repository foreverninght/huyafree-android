<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      窗口背景在 Activity 的 onCreate 之前就画出来了。
      主题可切换，所以这里不能写死某个颜色 —— 用一个中性色，
      再由 Activity 在 onCreate 第一时间换成实际主题色。
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F5F5F5</item>
        <item name="android:statusBarColor">#F5F5F5</item>
        <item name="android:navigationBarColor">#F5F5F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#FF5A1F</item>
    </style>

    <!-- 播放页：视频区必须纯黑，避免边框发灰 -->
    <style name="PlayerTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#FF5A1F</item>
    </style>
</resources>
